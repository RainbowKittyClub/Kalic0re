{
  "//": "Opened by admin/course/open_place_leaderboard_display, which fills in Position and Rotation's starting text and Back with the course's management dialog.",
  "type": "minecraft:confirmation",
  "title": {
    "translate": "kalic0re.parkour.menu.leaderboard_display.title",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "kalic0re.parkour.menu.course",
        "with": ["$(course)"]
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "kalic0re.parkour.menu.leaderboard_display.details"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:number_range",
      "key": "size",
      "label": {
        "translate": "kalic0re.parkour.menu.leaderboard_display.size"
      },
      "start": 0.25,
      "end": 4,
      "step": 0.25,
      "initial": 1
    },
    {
      "type": "minecraft:text",
      "key": "position",
      "width": 250,
      "initial": "$(place_position)",
      "label": {
        "translate": "kalic0re.parkour.menu.position_box"
      }
    },
    {
      "type": "minecraft:text",
      "key": "rotation",
      "width": 250,
      "initial": "$(place_rotation)",
      "label": {
        "translate": "kalic0re.parkour.menu.rotation_box"
      }
    }
  ],
  "yes": {
    "label": {
      "translate": "kalic0re.parkour.menu.leaderboard_display.confirm"
    },
    "action": {
      "type": "minecraft:dynamic/run_command",
      "template": "function kalic0re:parkour/admin/course/place_leaderboard_display {course:\"$(course)\",size:$(size),position:\"$(position)\",rotation:\"$(rotation)\"}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back"
    },
    "action": {
      "type": "minecraft:show_dialog"
    }
  }
}
