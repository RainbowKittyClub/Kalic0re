{
  "//": "Built by admin/displays/edit_board, which fills in the board's position and Size's initial value; its caller sets the exit.",
  "type": "minecraft:multi_action",
  "title": {
    "translate": "kalic0re.parkour.menu.leaderboard_display_edit.title",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "kalic0re.parkour.menu.leaderboard_display_edit.details",
        "with": ["$(course)"]
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "kalic0re.parkour.menu.leaderboard_display_edit.board_title_details"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "title",
      "width": 250,
      "max_length": 64,
      "initial": "$(current_title)",
      "label": {
        "translate": "kalic0re.parkour.menu.leaderboard_display_edit.board_title"
      }
    },
    {
      "type": "minecraft:number_range",
      "key": "size",
      "label": {
        "translate": "kalic0re.parkour.menu.leaderboard_display.size"
      },
      "start": 0.25,
      "end": 4,
      "step": 0.25,
      "initial": 1
    },
    {
      "type": "minecraft:text",
      "key": "position",
      "max_length": 100,
      "width": 250,
      "initial": "$(current_position)",
      "label": {
        "translate": "kalic0re.parkour.menu.position_box"
      }
    },
    {
      "type": "minecraft:text",
      "key": "rotation",
      "max_length": 100,
      "width": 250,
      "initial": "$(current_rotation)",
      "label": {
        "translate": "kalic0re.parkour.menu.rotation_box"
      }
    }
  ],
  "actions": [
    {
      "label": {
        "translate": "kalic0re.parkour.menu.leaderboard_display_edit.apply"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function kalic0re:parkour/admin/displays/edit_board_apply {x:$(x),y:$(y),z:$(z),size:$(size),title:\"$(title)\",position:\"$(position)\",rotation:\"$(rotation)\"}"
      }
    },
    {
      "label": {
        "translate": "kalic0re.parkour.menu.leaderboard_display_edit.remove"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "function kalic0re:parkour/admin/displays/remove_board {x:$(x),y:$(y),z:$(z)}"
      }
    }
  ],
  "columns": 2,
  "exit_action": {
    "label": {
      "translate": "gui.back"
    },
    "action": {
      "type": "minecraft:show_dialog"
    }
  }
}
