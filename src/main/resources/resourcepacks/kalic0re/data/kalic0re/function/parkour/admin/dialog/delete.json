{
  "//": "Opened by admin/course/open; Back is filled in with the course's management dialog.",
  "type": "minecraft:confirmation",
  "title": {
    "translate": "kalic0re.parkour.menu.delete.title",
    "bold": true
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "kalic0re.parkour.menu.course",
        "with": ["$(course)"]
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "translate": "kalic0re.parkour.menu.delete.details",
        "extra": [
          {
            "translate": "kalic0re.parkour.menu.delete.warning",
            "color": "red"
          }
        ]
      }
    }
  ],
  "yes": {
    "label": {
      "translate": "kalic0re.parkour.menu.delete.confirm",
      "color": "red"
    },
    "action": {
      "type": "minecraft:run_command",
      "command": "function kalic0re:parkour/admin/course/delete {course:\"$(course)\"}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back"
    },
    "action": {
      "type": "minecraft:show_dialog"
    }
  }
}
