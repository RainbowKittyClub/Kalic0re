{
  "//": "Filled in by admin/dialog/build_courses: New Course's dialog, then a course_button.json per course after Edit Nearby Leaderboard Display.",
  "type": "minecraft:multi_action",
  "title": {
    "translate": "kalic0re.parkour.menu.courses.title",
    "bold": true
  },
  "body": {
    "type": "minecraft:plain_message",
    "contents": {
      "translate": "kalic0re.parkour.menu.courses.details"
    }
  },
  "actions": [
    {
      "label": {
        "translate": "kalic0re.parkour.menu.courses.new_course"
      },
      "width": 250,
      "action": {
        "type": "minecraft:show_dialog"
      }
    },
    {
      "label": {
        "translate": "kalic0re.parkour.menu.courses.edit_leaderboard_display"
      },
      "width": 250,
      "action": {
        "type": "minecraft:run_command",
        "command": "function kalic0re:parkour/admin/displays/edit_nearest"
      }
    }
  ],
  "columns": 1,
  "exit_action": {
    "label": {
      "translate": "gui.done"
    }
  }
}
